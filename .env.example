# 本地开发默认配置。生产环境必须使用真实 HTTPS 地址和安全 Cookie。
BILLS_DATABASE_URL=sqlite:///./data/bills.db
BILLS_PUBLIC_ORIGIN=http://localhost:5173
BILLS_SECURE_COOKIES=false
BILLS_SESSION_HOURS=12
BILLS_DEVICE_DAYS=90
BILLS_ENV=development
DOMAIN=bills.example.com

# 使用 python -m app.cli generate-key 本地生成；API 与 worker 必须使用同一密钥。
# 留空时只允许手工上传资料，无法创建邮箱凭证。不要提交真实密钥。
BILLS_MASTER_KEY=
# 留空则使用数据库同目录下 sources；容器统一使用 /srv/data/sources。
BILLS_STORAGE_DIR=
